MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=zenstack360_connect
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional integrations (configure only when ready)
ABLY_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
OPENAI_API_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_APP_ID=
# Meta WhatsApp Embedded Signup configuration ID (Meta app dashboard)
META_WHATSAPP_CONFIG_ID=
# Gmail OAuth web client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Public HTTPS endpoint for Graph change notifications, e.g. https://app.example.com/api/webhooks/email
MICROSOFT_NOTIFICATION_URL=
# Protect POST /api/jobs/email-sync with this bearer token
JOBS_SECRET=
# 32-byte key encoded as 64 hex chars, dedicated to channel credential encryption
CREDENTIAL_ENCRYPTION_KEY=
# Optional Meta Graph API version override
META_GRAPH_VERSION=v22.0
# Billing integration (paid checkout remains unavailable until a provider adapter is installed)
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
# HMAC secret for signed campaign opt-out links
CAMPAIGN_OPTOUT_SECRET=
